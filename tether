#!/bin/bash
set -euo pipefail

REMOTE="${TETHER_REMOTE:-workspace}"
TARGET_DIR="${TETHER_TARGET:-/mnt/workspace/zephyr}"
SYNC="${TETHER_SYNC:-lace}"
LOCAL_DIR="${TETHER_LOCAL:-./}"

IGNORE=()
[[ -n "${TETHER_IGNORE:-}" ]] && read -ra IGNORE <<< "$TETHER_IGNORE"

RC="${TETHER_RC:-$(dirname "$(readlink -f "$0")")/.tetherrc}"
[[ -f "$RC" ]] && source "$RC"

REMOTE_PATH="$REMOTE:$TARGET_DIR"

PUSH=true
PULL=false
EXEC=true
DETACH=false
ARGS=()

usage() {
	cat <<EOF
Usage: tether [options] [--] <command...>

Sync the local tree to a remote build host, run a command there, and
optionally pull results back.

Options are only recognized before the remote command. Everything from
the first non-flag argument (or after '--') is passed through verbatim.

Options:
  --no-push       Skip the push step.
  --pull          Pull the remote tree back after the command runs.
  --no-exec       Sync only; do not run a command remotely.
  --detach        Run the remote command inside a detached tmux session.
  -i, --ignore <pat>
                  Skip paths matching <pat>. May be given more than once.
  -h, --help      Show this help.

Configuration (env vars or \$TETHER_RC, default ./.tetherrc):
  TETHER_REMOTE   SSH host or alias        (current: $REMOTE)
  TETHER_TARGET   Remote directory         (current: $TARGET_DIR)
  TETHER_LOCAL    Local directory          (current: $LOCAL_DIR)
  TETHER_SYNC     Sync backend: lace|rsync (current: $SYNC)
  TETHER_IGNORE   Space-separated patterns (current: ${IGNORE[*]-})
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--no-push)  PUSH=false; shift ;;
		--pull)     PULL=true;  shift ;;
		--no-exec)  EXEC=false; shift ;;
		--detach)   DETACH=true; shift ;;
		-i|--ignore) IGNORE+=("${2:?--ignore requires a pattern}"); shift 2 ;;
		-h|--help)  usage; exit 0 ;;
		--)         shift; ARGS=("$@"); break ;;
		*)          ARGS=("$@"); break ;;
	esac
done

sync() {
	local src="$1" dst="$2" p ign=()
	case "$SYNC" in
		lace)
			src="${src%/}"
			dst="${dst%/}"
			for p in ${IGNORE[@]+"${IGNORE[@]}"}; do ign+=(--ignore "$p"); done
			time lace ${ign[@]+"${ign[@]}"} "$src" "$dst"
			;;
		rsync)
			# rsync needs a trailing slash on src to copy contents
			# rather than the directory itself.
			[[ "$src" == */ ]] || src="$src/"
			for p in ${IGNORE[@]+"${IGNORE[@]}"}; do ign+=(--exclude "$p"); done
			time rsync -az --delete --inplace \
				--info=progress2 \
				${ign[@]+"${ign[@]}"} "$src" "$dst"
			;;
		*)
			echo "tether: unknown TETHER_SYNC backend: $SYNC" >&2
			exit 2
			;;
	esac
}

rexec() {
	ssh -t "$REMOTE" "bash -lc 'cd $(printf %q "$TARGET_DIR" | sed 's/\\~/~/g') && $1'"
}

if $EXEC && [[ ${#ARGS[@]} -eq 0 ]]; then
	echo "tether: no command given (use --no-exec to sync only)" >&2
	usage >&2
	exit 1
fi

if $PUSH; then
	sync "$LOCAL_DIR" "$REMOTE_PATH"
fi

if $EXEC; then
	cmd=$(printf '%q ' "${ARGS[@]}")
	if $DETACH; then
		session="tether-$(date +%s)-$$"
		echo "tether: detaching as tmux session '$session'"
		rexec "tmux new-session -d -s $(printf %q "$session") $cmd"
		exit 0
	fi
	rexec "$cmd"
fi

if $PULL; then
	sync "$REMOTE_PATH" "$LOCAL_DIR"
fi
